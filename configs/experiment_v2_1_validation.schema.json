{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "protocol_version", "frozen", "execution_id", "partition", "exposure_policy", "profile_observation_config", "closed_loop_config", "policy_sensitivity_config", "output_root", "selection"],
      "properties": {
        "name": {"const": "movie-recommender-v2_1-validation"},
        "version": {"const": "2.1.0-validation"},
        "protocol_version": {"const": "protocol-v2.1"},
        "frozen": {"const": true},
        "execution_id": {"const": "execution-v2.1"},
        "partition": {"const": "validation"},
        "exposure_policy": {"const": "shared-seeded-v2.1"},
        "profile_observation_config": {"const": "configs/agents/profile_observation_v2.yaml"},
        "closed_loop_config": {"const": "configs/experiments/closed_loop_v2_1.yaml"},
        "policy_sensitivity_config": {"const": "configs/experiments/policy_sensitivity_v2_1.yaml"},
        "output_root": {"const": "results/v2_1/raw/validation"},
        "selection": {
          "type": "object", "additionalProperties": false,
          "required": ["required"],
          "properties": {"required": {"const": false}}
        }
      }
    }
  }
}
