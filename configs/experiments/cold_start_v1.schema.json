{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "frozen", "methods", "profiles"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "frozen": {"const": true},
    "methods": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["B0", "B1", "B2", "B3", "B4", "B5"]}
    },
    "profiles": {
      "type": "object", "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3", "P4", "P5"],
      "properties": {
        "P0": {"$ref": "#/$defs/profile"}, "P1": {"$ref": "#/$defs/profile"},
        "P2": {"$ref": "#/$defs/profile"}, "P3": {"$ref": "#/$defs/profile"},
        "P4": {"$ref": "#/$defs/profile"}, "P5": {"$ref": "#/$defs/profile"}
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["allowed_fields"],
      "properties": {
        "allowed_fields": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["ranked_genres", "decade_preference", "popularity_preference", "preferred_directors", "preferred_keywords"]}
        }
      }
    }
  }
}
