{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "frozen", "deterministic_methods", "exclusions"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "frozen": {"const": true},
    "deterministic_methods": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["B0", "B1", "B2", "B3", "B4", "B5"]}
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["when", "reason"],
        "properties": {
          "reason": {"type": "string", "minLength": 1},
          "when": {
            "type": "object", "minProperties": 1, "additionalProperties": false,
            "properties": {
              "method": {"type": "array", "items": {"type": "string"}},
              "condition": {"type": "array", "items": {"type": "string"}},
              "profile": {"type": "array", "items": {"type": "string"}},
              "persona": {"type": "array", "items": {"type": "string"}},
              "seed": {"type": "array", "items": {"type": "integer"}},
              "k": {"type": "array", "items": {"type": "integer"}},
              "run": {"type": "array", "items": {"type": "integer"}}
            }
          }
        }
      }
    }
  }
}
