{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "frozen", "execution_id", "exposure_policy", "methods", "conditions", "profiles", "personas", "seeds", "k_values", "policy_scenario_ids"],
  "properties": {
    "version": {"const": "2.1"},
    "frozen": {"const": true},
    "execution_id": {"const": "execution-v2.1"},
    "exposure_policy": {"const": "shared-seeded-v2.1"},
    "methods": {"const": ["B4", "B5"]},
    "conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["C0", "C1", "C2", "C3", "C4", "C5"]}},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5"]}},
    "personas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["broad", "consistent", "contradictory", "exploratory", "noisy", "popularity_sensitive", "specific"]}},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "k_values": {"const": [5]},
    "policy_scenario_ids": {"const": ["S0", "S1", "S2", "S3", "S4", "S5", "S6"]}
  }
}
