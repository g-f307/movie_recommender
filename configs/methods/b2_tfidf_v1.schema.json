{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B2 TF-IDF baseline configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["method", "version", "frozen", "formula", "item_fields", "profile_fields", "vectorizer", "empty_document", "unknown_term", "fit_partition"],
  "properties": {
    "method": {"const": "B2"},
    "version": {"type": "string", "minLength": 1},
    "frozen": {"const": true},
    "formula": {"const": "tfidf_cosine_similarity"},
    "item_fields": {
      "const": ["sinopse", "genres", "palavras_chave"]
    },
    "profile_fields": {"const": ["ranked_genres"]},
    "vectorizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lowercase", "strip_accents", "stop_words", "ngram_range", "max_features", "min_df", "sublinear_tf", "norm"],
      "properties": {
        "lowercase": {"const": true},
        "strip_accents": {"const": "unicode"},
        "stop_words": {"type": "null"},
        "ngram_range": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "max_features": {"type": "integer", "minimum": 1},
        "min_df": {"type": "integer", "minimum": 1},
        "sublinear_tf": {"const": true},
        "norm": {"const": "l2"}
      }
    },
    "empty_document": {"const": "zero_vector"},
    "unknown_term": {"const": "ignored"},
    "fit_partition": {"const": "train"}
  }
}
